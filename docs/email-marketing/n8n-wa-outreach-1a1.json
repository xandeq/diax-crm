    },
    {
      "parameters": {
        "jsCode": "// CAP 20/dia, só P1-P3 (mude MAX_PRIO p/ 4 depois de medir). Dedupe por chat_id no dia via staticData.\nconst MAX_PRIO = 3, CAP = 20;\nconst raw = Buffer.from($input.first().binary.data.data, 'base64').toString('utf8');\nconst leads = JSON.parse(raw).leads;\nconst sd = $getWorkflowStaticData('global');\nconst today = new Date().toISOString().slice(0,10);\nif (sd.day !== today) { sd.day = today; sd.sent = []; }\nconst done = new Set(sd.sent || []);\nconst out = leads.filter(l => l.priority <= MAX_PRIO && !done.has(l.chat_id)).slice(0, CAP);\nreturn out.map(l => ({ json: l }));"
      },
      "id": "n3", "name": "Filtrar P1-P3 + cap", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 0]
    },
    {
      "parameters": {"options": {}},
      "id": "n4", "name": "Um por vez", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [660, 0]
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:3000/api/contacts/check-exists?phone={{ $json.phone_e164 }}&session=default",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "options": {}
      },
      "id": "n5", "name": "WAHA check-exists", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [880, 0],
      "credentials": {"httpHeaderAuth": {"id": "FyQzLibob5SsjmDF", "name": "WAHA (X-Api-Key)"}}
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"}, "conditions": [{"id": "c1", "leftValue": "={{ $json.numberExists }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true"}}], "combinator": "and"}, "options": {}},
      "id": "n6", "name": "Existe no WhatsApp?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "POST", "url": "http://127.0.0.1:3000/api/startTyping",
        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $('Um por vez').item.json.chat_id }) }}", "options": {}
      },
      "id": "n7", "name": "startTyping", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1320, -120],
      "credentials": {"httpHeaderAuth": {"id": "FyQzLibob5SsjmDF", "name": "WAHA (X-Api-Key)"}}
    },
    {
      "parameters": {"amount": 3, "unit": "seconds"},
