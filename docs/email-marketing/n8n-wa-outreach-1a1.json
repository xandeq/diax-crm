        "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ customerId: $('Um por vez').item.json.id, event: 'sent', provider: 'waha', messageId: String($json.id || '') }) }}",
        "options": {}
      },
      "id": "n10", "name": "CRM: marcar enviado", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1980, -120],
      "credentials": {"httpHeaderAuth": {"id": "CRIAR_CRED_X-Integration-Key", "name": "DIAX CRM (X-Integration-Key)"}}
    },
    {
      "parameters": {
        "jsCode": "// registra no dia p/ dedupe + jitter 45-120s\nconst sd = $getWorkflowStaticData('global');\nsd.sent = sd.sent || [];\nsd.sent.push($('Um por vez').item.json.chat_id);\nreturn [{ json: { wait: 45 + Math.floor(Math.random()*75) } }];"
      },
