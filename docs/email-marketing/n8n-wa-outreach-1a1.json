        "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $('Um por vez').item.json.chat_id, text: $('Um por vez').item.json.message }) }}", "options": {}
      },
      "id": "n9", "name": "sendText", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1760, -120],
      "credentials": {"httpHeaderAuth": {"id": "FyQzLibob5SsjmDF", "name": "WAHA (X-Api-Key)"}}
    },
